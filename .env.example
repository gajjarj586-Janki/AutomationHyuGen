# Copy this file to .env and fill in your own values.
# Never commit .env — it contains secrets.

# ─── Confluence API ─────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://orchardhome.atlassian.net/wiki
CONFLUENCE_EMAIL=your.email@orchard.com.au
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
# (use "Create API token", NOT "Create API token with scopes")
CONFLUENCE_API_TOKEN=your-atlassian-api-token

# Only used by scripts/uploadReportToConfluence.js (posting the PDF test
# report back to the Confluence page) and by the optional one-off
# scripts/refreshLocalTestData.js. Feature files and test data are no longer
# fetched from Confluence at test-run time — see
# features/cucumber/test-data/localTestData.js.
CONFLUENCE_TEST_DATA_PAGE_ID=1776353299
CONFLUENCE_FEATURE_FILE_PAGE_ID=1729724417

# ─── Test Configuration ─────────────────────────────────────────
# Controls which environment the suite runs against AND which URL column of
# localTestData.js's "Environment URLs" table is used: Dev, Dev1, Stage, or
# Production. Also selects the "<TARGET_ENVIRONMENT> Report" column on the
# Confluence report-upload page.
TARGET_ENVIRONMENT=Stage
HEADLESS=true

# ─── Stage PIM (scripts/pimLogin.js, scripts/openPimAuthed.js) ──
#PIM_USER=you@example.com
#PIM_PASS=your-password
#PIM_OTP=123456              # optional, only if MFA prompts
#PIM_TOKEN=eyJ...            # optional, for openPimAuthed.js when you already have a JWT

# ─── ROAP admin portal (ROAP.feature / ROAP_auto.steps.js) ─────
#ROAP_USERNAME=you@example.com
#ROAP_PASSWORD=your-password
